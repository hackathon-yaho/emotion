# ai-server 환경변수 — 실제 값은 .env 에만. 이 파일은 키 이름과 기본값의 계약이다.
# 근거: docs/02-architecture/ai-pipeline.md §13

# ── 서버 ──────────────────────────────────────────────
AI_PORT=8100
# Hume Config에 등록한 CLM URL의 origin. URL은 반드시 https://…/chat/completions 로 끝난다. 로컬은 ngrok.
AI_PUBLIC_URL=

# ── 백엔드 연동 ────────────────────────────────────────
# 백엔드 로컬 포트는 8080이다 (request/ai/integration-test-path.md).
BACKEND_BASE_URL=http://localhost:8080
# X-Internal-Secret (계약 §3-1). 양쪽 환경변수로만 주입. 저장소에 넣지 않는다.
INTERNAL_SHARED_SECRET=
# /internal/turns 재시도 횟수. 계약 v1.3에서 1 -> 3으로 상향, 전 세션 동일 적용.
# 5xx·타임아웃에만 지수 백오프(200ms·600ms·1800ms)로 재시도한다. 4xx는 재시도하지 않는다.
AI_TURN_POST_RETRIES=3
# 세션 컨텍스트 조회(계약 §3-4) 타임아웃. ★ 통합 테스트로 양쪽을 터널로 열 때는 2000으로 올린다 ★
# 이 조회는 CLM 인증을 겸하고 캐시 미스 시 fail-closed(401)라, 짧으면 대화가 막힌다.
AI_SESSION_LOOKUP_TIMEOUT_MS=800
# 연결 단계 실패에만 재시도. 4xx·5xx 응답은 재시도하지 않는다 — 터널 재시작의 연결 거부와 백엔드의 거절은 다르다.
AI_SESSION_LOOKUP_CONNECT_RETRY=1
# 같은 세션에서 이 시간 이상 턴이 없으면 캐시를 버리고 재조회한다 (ai-pipeline.md §7.2).
# 이어하기(계약 §2-5-1)는 AI서버에 보이지 않으므로 유휴 간격으로 감지하고, lastTurnIndex를 다시 읽는다.
AI_SESSION_REFETCH_IDLE_SEC=60

# ── LLM ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
# 분석 호출: 전사만 입력. 빠른 모델. temperature 0 사용 가능(haiku 4.5)
AI_MODEL_ANALYZE=claude-haiku-4-5
# 응답 호출: 대화 텍스트 스트리밍. sonnet-5/opus-5는 temperature 등 샘플링 파라미터를 받지 않는다(400)
AI_MODEL_RESPOND=claude-sonnet-5
AI_RESPOND_EFFORT=low
# 관찰 문장화(배치, 비실시간)
AI_MODEL_OBSERVE=claude-opus-5
AI_OBSERVE_EFFORT=medium
# 세션 요약(계약 §3-5, 동기). 입력이 짧고 출력이 1문장이라 빠른 모델을 쓴다.
AI_MODEL_SUMMARY=claude-haiku-4-5
# 분석 호출 타임아웃. 초과 시 text_valence=null, tags=[], crisis_llm=null 로 진행 (FR-024)
AI_ANALYZE_TIMEOUT_MS=400
# 요약 호출 타임아웃. 계약 §3-5가 백엔드 쪽 3초를 규정하므로 그 안쪽에서 끝낸다.
AI_SUMMARY_TIMEOUT_MS=2500
# 추측 실행(ai-pipeline.md §2.7). TC-12 p95 2초 미달 시에만 true
AI_SPECULATIVE_RESPOND=false

# ── 규칙 ──────────────────────────────────────────────
# 고정 임계값 — ★ 임시값 ★. 계약서 §2-4 예시와 동일. 20쌍 측정 후 교체(ai-pipeline.md §4.3).
# 백엔드 세션 조회값(gapThreshold)이 있으면 그것이 우선하고, 이 값은 조회 실패 시 폴백이다.
AI_GAP_THRESHOLD_FIXED=0.85
# P+N 이 이 값 미만이면 voice_valence=null (중립 감정만 찍힌 발화)
AI_VOICE_VALENCE_MIN_MASS=0.05
# ── 캡처 (app/capture.py) ─────────────────────────────
# 요청 뼈대(키 이름 + 값의 타입)를 남긴다. 발화·점수 값은 담기지 않아 기본으로 켜 둔다.
# Hume이 실제로 보내는 모양을 우리는 아직 본 적이 없다 — 첫 연결에서 반드시 남겨야 한다.
AI_SHAPE_CAPTURE=true
# 갭 20쌍용 스냅샷(전사 + prosody 점수). ★ 발화가 저장된다 ★ — 팀원이 정해진 문장을 읽는
# 도그푸딩에서만 켠다. 실사용자 대화에서는 켜지 않는다.
AI_EVAL_CAPTURE=false
# 캡처 저장 위치. gitignore 대상이다.
AI_CAPTURE_DIR=./eval/capture

# 규칙 파일 경로 (기본값 그대로 두면 된다)
AI_RULES_DIR=./rules
AI_PROMPTS_DIR=./prompts

# ── 로깅 ──────────────────────────────────────────────
# 구조화 로그 레벨. 어떤 레벨에서도 발화 내용은 찍히지 않는다(FR-092) — 필드 화이트리스트로 강제.
AI_LOG_LEVEL=info
