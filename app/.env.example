# 앱 환경변수. 이 파일을 .env로 복사해서 값을 채웁니다.
# .env는 커밋하지 않습니다 (저장소 루트 .gitignore).

# 백엔드 배포 도메인. 앱에 하드코딩 금지 (계약서 §1-1)
API_BASE_URL=http://localhost:8080

# Hume Config ID는 여기 없습니다.
# 계약 v1.3부터 POST /api/session/start 응답의 humeConfigId로 옵니다 (§2-4).
# 백엔드가 기동 시 fail-fast로 검증하므로 앱은 폴백을 두지 않습니다.

# 카카오 JavaScript 앱 키 (웹 로그인). 공개되는 키이며 도메인 등록으로 보호됩니다.
KAKAO_JS_KEY=
