# 앱 환경변수. 이 파일을 .env로 복사해서 값을 채웁니다.
# .env는 커밋하지 않습니다 (저장소 루트 .gitignore).

# 백엔드 배포 도메인. 앱에 하드코딩 금지 (계약서 §1-1)
API_BASE_URL=http://localhost:8080

# Hume EVI Config ID.
# 계약에 아직 없어 임시로 로컬 값으로 씁니다 — docs/request/backend/hume-config-id.md (⏳)
# 백엔드가 POST /api/session/start 응답에 humeConfigId를 넣으면 이 값을 지웁니다.
HUME_CONFIG_ID=

# 카카오 JavaScript 앱 키 (웹 로그인). 공개되는 키이며 도메인 등록으로 보호됩니다.
KAKAO_JS_KEY=
