# 로컬 개발용. 실제 .env는 커밋하지 않는다 (루트 .gitignore가 .env*를 막는다).
# 값 생성:  openssl rand -base64 32
#
# 배포용 키와 로컬 키를 분리한다 — DB가 compose/Supabase로 나뉘어 있어
# 섞일 일이 없고, 로컬 키가 새도 도그푸딩 데이터는 안전하다 (phase-1 1-3-1).

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/emotion
SPRING_DATASOURCE_USERNAME=emotion
SPRING_DATASOURCE_PASSWORD=emotion

# 잃어도 재발급하면 끝이다 (전원 재로그인).
JWT_SECRET=

# 카카오 디벨로퍼스 > 앱 설정 > 앱 키 화면의 "앱 ID"(숫자). 비밀이 아니다.
KAKAO_APP_ID=

# Phase 2부터. 계정을 AI가 소유하므로 AI에게서 받는다.
# HUME_API_KEY=
# HUME_SECRET_KEY=
# HUME_CONFIG_ID=

# Phase 2·3부터. INTERNAL_SHARED_SECRET은 잃어도 AI와 다시 나누면 된다.
# TRANSCRIPT_ENC_KEY는 잃으면 발화가 영구 복호화 불가다 — 오프라인 사본을 둔다.
# INTERNAL_SHARED_SECRET=
# TRANSCRIPT_ENC_KEY=
